{
  "name": "amlint-playground",
  "private": true,
  "description": "Build tooling for the amlint browser playground: the CodeMirror bundle and the smoke test",
  "type": "module",
  "scripts": {
    "build:editor": "esbuild codemirror.mjs --bundle --format=esm --minify --target=es2020 --outfile=../docs/playground/dist/codemirror.js",
    "smoke": "node smoke-test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
