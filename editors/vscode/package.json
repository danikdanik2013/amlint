{
  "name": "amlint",
  "displayName": "amlint: Alertmanager config linter",
  "description": "Finds misrouted, unreachable and over-inhibited alerts in Prometheus Alertmanager configs as you type, and shows on hover where each route sends alerts.",
  "version": "0.1.2",
  "publisher": "dpyly",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1c2654",
    "theme": "dark"
  },
  "homepage": "https://danikdanik2013.github.io/amlint/editors/",
  "repository": {
    "type": "git",
    "url": "https://github.com/danikdanik2013/amlint.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/danikdanik2013/amlint/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "alertmanager",
    "prometheus",
    "alerting",
    "yaml",
    "lint",
    "kubernetes",
    "sre"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "workspaceContains:**/*.tmpl"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, amlint.path is read only from your user settings.",
      "restrictedConfigurations": [
        "amlint.path"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "amlint",
      "properties": {
        "amlint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Lint Alertmanager configs with amlint."
        },
        "amlint.path": {
          "type": "string",
          "default": "amlint",
          "markdownDescription": "The `amlint` executable to run as `amlint lsp`. A name is looked up on `PATH`. `~` and `${workspaceFolder}` are expanded, for example `${workspaceFolder}/.venv/bin/amlint`. Left at `amlint` and not on `PATH`, amlint is looked for where Homebrew and pipx install it, and in a trusted workspace's `.venv`."
        },
        "amlint.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and amlint to the amlint output channel."
        }
      }
    },
    "commands": [
      {
        "command": "amlint.restart",
        "title": "Restart Server",
        "category": "amlint"
      }
    ]
  },
  "scripts": {
    "check": "tsc -p ./ --noEmit",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --minify --sourcemap --outfile=out/extension.js",
    "compile": "npm run check && npm run bundle",
    "test": "esbuild src/preflight.ts --bundle --platform=node --format=cjs --target=node20 --outfile=out/test/preflight.js --log-level=warning && node --test test/preflight.test.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "ovsx": "1.2.0",
    "typescript": "5.9.3"
  }
}
